# Required before a production build. Use the canonical custom domain, including https://.
NEXT_PUBLIC_SITE_URL=

# Supabase project settings (public client credentials, never a service-role key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only email delivery settings.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional ownership verification tokens from Search Console / Bing Webmaster Tools.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
