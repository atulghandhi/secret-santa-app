# Canonical public origin, including https:// and no path. Set this once you have a custom domain.
# On Vercel it is optional: builds fall back to the project's production *.vercel.app domain.
# Required for production builds anywhere else.
NEXT_PUBLIC_SITE_URL=

# Supabase project settings (public client credentials, never a service-role key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only email delivery settings.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional ownership verification tokens from Search Console / Bing Webmaster Tools.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
